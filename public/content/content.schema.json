{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content.schema.json",
  "title": "PageContent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./content.schema.json"
    },
    "id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Section"
      }
    }
  },
  "required": ["id", "slug", "sections", "contents"],
  "$defs": {
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/SectionContent"
        }
      },
      "required": ["id", "name"]
    },
    "SectionContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "string"
        },
        "subheader": {
          "type": "string"
        },
        "preheader": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    }
  }
}
